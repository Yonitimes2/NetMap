# Copy this file to .env.local and fill in your key from console.anthropic.com → Settings → API Keys.
# .env.local is git-ignored; never commit a real key.
ANTHROPIC_API_KEY=

# Database (MySQL 8): users, business accounts and their maps. Tables are created on first start;
# the database itself and a user that owns it must exist.
DATABASE_URL=mysql://netmap_dev:CHANGE_ME@127.0.0.1:3306/netmap_dev

# Keys and uploaded images live in $NETMAP_DATA_DIR (default: .netmap-data/ here, git-ignored).
# On the server, point it outside the git checkout, e.g. NETMAP_DATA_DIR=/var/lib/netmap
# NETMAP_DATA_DIR=
# Session-cookie signing key. If unset, a random key is created once in NETMAP_DATA_DIR/session.key.
# AUTH_SECRET=
# Key that encrypts equipment passwords in the database. If unset, created once in NETMAP_DATA_DIR/data.key.
# Back it up together with the database: without it the stored passwords can't be read.
# NETMAP_DATA_KEY=
